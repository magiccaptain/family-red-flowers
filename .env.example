# Setup account: only database/initialize.py uses this account.
PG_HOST=your-pg-host
PG_PORT=5432
PG_USERNAME=your-setup-account
PG_PASSWORD=your-setup-password
PG_DATABASE=postgres
# Optional: require/verify-full when PostgreSQL TLS is configured.
PG_SSLMODE=prefer
# The setup script adds RF_APP_USERNAME, RF_APP_PASSWORD, RF_FAMILY_ID.
# Never put .env or artifacts/pg-connection.json in an APK or a Git repository.
